# Unified Streams — Environment Configuration Example

# Instance profile: "beamup", "railway", or "generic" (local development).
# Profile defaults live in config/instances/<profile>.env. Any value set
# directly in the platform environment overrides the profile default.
INSTANCE_PROFILE=generic

# Non-secret defaults (matches config/defaults.env)
PORT=7000
DATA_DIR=/data
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SINK=stdout
LOG_SAMPLE_RATE=0.1
LOG_SLOW_MS=2000
LOG_BATCH_SIZE=200
LOG_FLUSH_MS=5000
LOG_QUEUE_MAX=10000
CACHE_TTL_MS=180000
CACHE_PARTIAL_TTL_MS=30000
BACKEND_TIMEOUT_MS=12000
GLOBAL_DEADLINE_MS=13000
MAX_STREAMS_PER_PROVIDER=100
MAX_STREAMS=1000
SEARCH_CONCURRENCY=30
SEARCH_TIMEOUT_MS=10000
SCRAPER_CONCURRENCY=30
SA7_CONCURRENCY=30
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=300000
UPDATE_ON_START=true
UPDATE_INTERVAL_MIN_HOURS=20
UPDATE_INTERVAL_MAX_HOURS=24
CINEMETA_URL=https://v3-cinemeta.strem.io
ANIMEAPI_URL=https://animeapi.my.id
KITSU_URL=https://kitsu.io/api/edge
TVMAZE_URL=https://api.tvmaze.com
JIKAN_URL=https://api.jikan.moe/v4
JIKAN_MAX_RPS=3
JIKAN_MAX_RPM=60
SA7_INTERNAL_URL=http://127.0.0.1:7001
NUVIO_INTERNAL_URL=http://127.0.0.1:7002
VEGA_INTERNAL_URL=http://127.0.0.1:7003

# Provider policy lives in config/providers.json. INSTANCE_PROFILE selects the
# profile; unknown values and "generic" fall back to defaultProfile. Duplicate
# copies are derived from duplicatePriority + duplicates, so do not list them
# in profile deny lists. "locked" providers cannot be toggled from /admin.

# Deployment Secrets and Overrides
PUBLIC_BASE_URL=
TMDB_API_KEY=
FEBBOX_UI_COOKIE=
GRAMCINEMA_TOKEN=
KARTOONS_TOKEN=
PROVIDER_SETTINGS_JSON=
COOKIES_FILE=
GITHUB_TOKEN=
INTERNAL_TOKEN=
ADMIN_TOKEN=
CLOUDFLARE_LOG_ENDPOINT=
CLOUDFLARE_LOG_TOKEN=
# Optional Cloudflare D1 backup for /admin provider overrides. The endpoint is
# the same Worker base URL (no /v1 path). Click "Save to Cloudflare" in /admin
# after changing providers. Remote settings win at startup when present.
CLOUDFLARE_SETTINGS_ENDPOINT=
CLOUDFLARE_SETTINGS_TOKEN=
# Signs /proxy/manifest tokens. Use 32+ random characters and the same value on
# every replica. Falls back to INTERNAL_TOKEN, then ADMIN_TOKEN, then a random
# per-process secret with a warning (local/dev only).
MANIFEST_PROXY_SECRET=
MANIFEST_PROXY_TOKEN_TTL_MS=21600000
