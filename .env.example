# Unified Streams — Environment Configuration Example

# Instance profile: "beamup", "railway", or "generic" (local development).
# Profile defaults live in config/instances/<profile>.env. Any value set
# directly in the platform environment overrides the profile default.
INSTANCE_PROFILE=generic

# Non-secret defaults (matches config/defaults.env)
PORT=7000
DATA_DIR=/data
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SINK=stdout
LOG_SAMPLE_RATE=0.1
LOG_SLOW_MS=2000
LOG_BATCH_SIZE=200
LOG_FLUSH_MS=5000
LOG_QUEUE_MAX=10000
CACHE_TTL_MS=180000
CACHE_PARTIAL_TTL_MS=30000
BACKEND_TIMEOUT_MS=12000
GLOBAL_DEADLINE_MS=13000
MAX_STREAMS_PER_PROVIDER=100
MAX_STREAMS=1000
SEARCH_CONCURRENCY=30
SCRAPER_CONCURRENCY=30
SA7_CONCURRENCY=30
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=300000
UPDATE_ON_START=true
UPDATE_INTERVAL_MIN_HOURS=20
UPDATE_INTERVAL_MAX_HOURS=24
CINEMETA_URL=https://v3-cinemeta.strem.io
MAL_ENABLED=false
JIKAN_URL=https://api.jikan.moe/v4
JIKAN_MAX_RPS=3
JIKAN_MAX_RPM=60
SA7_INTERNAL_URL=http://127.0.0.1:7001
NUVIO_INTERNAL_URL=http://127.0.0.1:7002
VEGA_INTERNAL_URL=http://127.0.0.1:7003

# Per-instance provider overrides (optional, applied on top of the selected
# profile). ENABLED_* acts as an allow-list; DISABLED_* removes providers.
# Use "*" in a DISABLED_* list to disable every provider in that fleet.
# Beamup defaults (from config/providers.json instances.beamup):
#   SA7_DISABLED_PROVIDERS=*
#   NUVIO_ENABLED_SCRAPERS=sylphera
#   VEGA_ENABLED_PROVIDERS=animeworld,movies4u,luxMovies
# Railway defaults come from the top-level lists in config/providers.json.
# SA7_ENABLED_PROVIDERS=
# NUVIO_ENABLED_SCRAPERS=
# VEGA_ENABLED_PROVIDERS=
# SA7_DISABLED_PROVIDERS=
# NUVIO_DISABLED_SCRAPERS=
# VEGA_DISABLED_PROVIDERS=

# Deployment Secrets and Overrides
PUBLIC_BASE_URL=
TMDB_API_KEY=
PROVIDER_SETTINGS_JSON=
COOKIES_FILE=
GITHUB_TOKEN=
INTERNAL_TOKEN=
CLOUDFLARE_LOG_ENDPOINT=
CLOUDFLARE_LOG_TOKEN=
