# Unified Streams — Environment Configuration Example

# Non-secret defaults (matches config/defaults.env)
PORT=7000
DATA_DIR=/data
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SINK=stdout
LOG_SAMPLE_RATE=0.1
LOG_SLOW_MS=2000
LOG_BATCH_SIZE=200
LOG_FLUSH_MS=5000
LOG_QUEUE_MAX=10000
CACHE_TTL_MS=180000
CACHE_PARTIAL_TTL_MS=30000
BACKEND_TIMEOUT_MS=11000
GLOBAL_DEADLINE_MS=13000
MAX_STREAMS_PER_PROVIDER=100
MAX_STREAMS=1000
SEARCH_CONCURRENCY=30
SCRAPER_CONCURRENCY=30
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=300000
UPDATE_ON_START=true
UPDATE_INTERVAL_MIN_HOURS=20
UPDATE_INTERVAL_MAX_HOURS=24
CINEMETA_URL=https://v3-cinemeta.strem.io
MAL_ENABLED=false
JIKAN_URL=https://api.jikan.moe/v4
JIKAN_MAX_RPS=3
JIKAN_MAX_RPM=60
SA7_INTERNAL_URL=http://127.0.0.1:7001
NUVIO_INTERNAL_URL=http://127.0.0.1:7002
VEGA_INTERNAL_URL=http://127.0.0.1:7003

# Deployment Secrets and Overrides
PUBLIC_BASE_URL=
TMDB_API_KEY=
PROVIDER_SETTINGS_JSON=
COOKIES_FILE=
GITHUB_TOKEN=
INTERNAL_TOKEN=
CLOUDFLARE_LOG_ENDPOINT=
CLOUDFLARE_LOG_TOKEN=
